#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.P_W_N01.DialogueText
msgctxt ",8765C9CD49282E55816DF691DFD64AF9"
msgid "She looks like sleeping well."
msgstr "잘 자고 있는것 같다."

