msgctxt ",968A1D5D40819C4C775348A1C40555B6"
msgid "Hi. How's it going?"
msgstr "안녕하세요. 어때요?"

#. Key:	F8137C184962285442DE8E935B2F6CD1
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.P_W_01.SpeakerName
