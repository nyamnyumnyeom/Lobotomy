msgctxt ",EA4F2DCC4F0B107FEE0E3FAC1AEF7FF5"
msgid "Laim Daivs"
msgstr "리암 데이비스"

#. Key:	FBEFCA964CD5F731D155E78E3189F67E
#. SourceLocation:	/Game/NPC/BP_Patient_W2.BP_Patient_W2_C:ExecuteUbergraph_BP_Patient_W2 [Script Bytecode]
