msgid "Nurse"
msgstr "간호사"

#. Key:	30DC68E44EEE076A834F56BB924636DD
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Nu_n0_0.DialogueText
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Nu_n0_0.DialogueText
msgctxt ",30DC68E44EEE076A834F56BB924636DD"
msgid "What’s that in your hand?"
msgstr "손에 뭘 들고 돌아다니는 거죠?"

#. Key:	E9B95DC74581939A080583A25AF3930C
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Nu_n0_1.DialogueText
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Nu_n0_1.DialogueText
msgctxt ",E9B95DC74581939A080583A25AF3930C"
msgid "This? It’s obviously a patient chart."
msgstr "이거요? 당연히 환자 차트죠."

#. Key:	DC032A294573EE84CFFE68BFF9F616F3
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Nu_n0_1.SpeakerName
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Nu_n0_1.SpeakerName
