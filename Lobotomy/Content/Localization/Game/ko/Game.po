#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Nu_3.DialogueText
msgctxt ",B75A45A84F90F28BAE6B8CB21B8BDF15"
msgid "Without it, the patients won’t know who I am."
msgstr "없으면 환자들이 절 못 알아보잖아요."

#. Key:	B275BC9242A1DA5BD4D0B398873ABDCF
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Nu_3.SpeakerName
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Nu_3.SpeakerName
msgctxt ",B275BC9242A1DA5BD4D0B398873ABDCF"
msgid "Me"
msgstr "나"

#. Key:	CCF74794425F41A9672B009E39781107
