#. Key:	F78A9E314F7F617C57874CA2DC840B58
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_1.DialogueText
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_1.DialogueText
msgctxt ",F78A9E314F7F617C57874CA2DC840B58"
msgid "Oh! Good to see you. We meet again."
msgstr "오! 반갑네요. 여기서 다 만나네요."

#. Key:	901CE7ED4BDC8F279701D383C718A8D1
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_1.SpeakerName
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_1.SpeakerName
msgctxt ",901CE7ED4BDC8F279701D383C718A8D1"
msgid "Jeong woo Park"
msgstr "박정우"

#. Key:	6CC1A95641F0E9CDDC7868A575BC50F1
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_10.DialogueText
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_10.DialogueText
msgctxt ",6CC1A95641F0E9CDDC7868A575BC50F1"
msgid "...Promise me you'll head straight back to your hospital room right after we go there."
msgstr "...거기 갔다 오면 바로 병실로 돌아가는 거예요. 약속해요."

#. Key:	01036AAC4E44E1543B0E5D8AD5B0B5C4
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_10.SpeakerName
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_10.SpeakerName
msgctxt ",01036AAC4E44E1543B0E5D8AD5B0B5C4"
msgid "Me"
msgstr "나"

#. Key:	1F7BFD06401F0B2CDC72519400FE09D9
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_11.DialogueText
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_11.DialogueText
msgctxt ",1F7BFD06401F0B2CDC72519400FE09D9"
msgid "Of course. I’m too scared to go alone... Please come with me."
msgstr "물론이죠. 혼자는 좀 무서우니까... 같이 가주세요."

#. Key:	F772A7DF4DF519E7459DA5901262A82B
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_2.DialogueText
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_2.DialogueText
msgctxt ",F772A7DF4DF519E7459DA5901262A82B"
msgid "What are you doing here at this time?"
msgstr "이 시간에 여기서 뭐 하는 거예요?"

#. Key:	EB355A7F4256751673BF5699A503D591
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_2.SpeakerName
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_2.SpeakerName
msgctxt ",EB355A7F4256751673BF5699A503D591"
msgid "Me"
msgstr "나"

#. Key:	2CA60CB7402E529B07DCC18314CF2F92
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_3.DialogueText
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_3.DialogueText
msgctxt ",2CA60CB7402E529B07DCC18314CF2F92"
msgid "I couldn’t sleep, so I was wandering around... Then I saw the door open, so I came down to take a look."
msgstr "잠이 안 와서 이리저리 돌아다니다가 문이 열려 있길래... 한번 내려와 봤어요."

#. Key:	8F68116A468598302AD131B873ED8102
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_4.DialogueText
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_4.DialogueText
msgctxt ",8F68116A468598302AD131B873ED8102"
msgid "I told you before. You shouldn’t be wandering around alone this late at night..."
msgstr "저번에도 말했잖아요. 밤늦게 혼자 돌아다니는 건.."

#. Key:	B32B836A4A8BE51A7BA0AFA07977D51E
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_4.SpeakerName
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_4.SpeakerName
msgctxt ",B32B836A4A8BE51A7BA0AFA07977D51E"
msgid "Me"
msgstr "나"

#. Key:	471D0BA04D8380D4015A50AE727111B0
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_5.DialogueText
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_5.DialogueText
msgctxt ",471D0BA04D8380D4015A50AE727111B0"
msgid "Shh... Hold on."
msgstr "쉿. 잠시만요."

#. Key:	147A1DAC46254F693A7A74A7DBF669DE
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_6.DialogueText
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_6.DialogueText
msgctxt ",147A1DAC46254F693A7A74A7DBF669DE"
msgid "...What?"
msgstr "...네?"

#. Key:	E4779842473594F8EDEB628ED550A676
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_6.SpeakerName
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_6.SpeakerName
msgctxt ",E4779842473594F8EDEB628ED550A676"
msgid "Me"
msgstr "나"

#. Key:	7B1557C246F1FFB3DE25C793FD72D4AF
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_7.DialogueText
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_7.DialogueText
msgctxt ",7B1557C246F1FFB3DE25C793FD72D4AF"
msgid "Don’t you hear that sound?"
msgstr "무슨 소리 안 들려요?"

#. Key:	EA502BA94E553629748D148F3E04F95E
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_8.DialogueText
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_8.DialogueText
msgctxt ",EA502BA94E553629748D148F3E04F95E"
msgid "I don’t hear anything. More importantly, go back to your room. Now."
msgstr "아무 소리도 안 들리는데요. 그보다 지금 당장 병실로 올라가요."

#. Key:	543B18BB44661DC2911E4D88B7FD0129
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_8.SpeakerName
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_8.SpeakerName
msgctxt ",543B18BB44661DC2911E4D88B7FD0129"
msgid "Me"
msgstr "나"

#. Key:	FEB7B53044552E05256A10817344D78F
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_9.DialogueText
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_9.DialogueText
msgctxt ",FEB7B53044552E05256A10817344D78F"
msgid "Wait... Just a moment... Was that upstairs? It sounded like it came from the morgue. Would you like to come with me?"
msgstr "잠깐만요, 잠깐....위층인가? 영안실 쪽에서 나는 것 같은데. 같이 가보실래요?"

#. Key:	E8D25C2A4DC3418BC24931BA879C01B9
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.H_Day_01.DialogueText
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.H_Day_01.DialogueText
msgctxt ",E8D25C2A4DC3418BC24931BA879C01B9"
msgid "He’s sleeping… at this time?"
msgstr "잠을 자고 있다...이 시간에?"

#. Key:	075914A047FAD701FCABF6B327D2A9DE
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.H_Day_01.SpeakerName
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.H_Day_01.SpeakerName
msgctxt ",075914A047FAD701FCABF6B327D2A9DE"
msgid "???"
msgstr "???"

