msgctxt ",3BE7A70841218395FA1630BA04A89E35"
msgid "What's going on..."
msgstr ""

#. Key:	3C3D32AB4EAED175A165CEA66ED97244
#. SourceLocation:	/Game/SQ/Last_Run_SQ.Last_Run_SQ_DirectorBP_C:ExecuteUbergraph_Last_Run_SQ_DirectorBP [Script Bytecode]
#: /Game/SQ/Last_Run_SQ.Last_Run_SQ_DirectorBP_C:ExecuteUbergraph_Last_Run_SQ_DirectorBP [Script Bytecode]
msgctxt ",3C3D32AB4EAED175A165CEA66ED97244"
msgid "Should I fix you too?"
msgstr "너도 치료 해줄까?"

#. Key:	52DBE7E84DC662AAF15DC3AD7C8670F2
#. SourceLocation:	/Game/SQ/Last_Run_SQ.Last_Run_SQ_DirectorBP_C:ExecuteUbergraph_Last_Run_SQ_DirectorBP [Script Bytecode]
