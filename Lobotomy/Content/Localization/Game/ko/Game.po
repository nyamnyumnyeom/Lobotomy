msgid "Jeong woo?"
msgstr "박정우 환자 ?"

#. Key:	C246418D4333C715B13D458835CA7F30
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_0.SpeakerName
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Dc_0.SpeakerName
