msgctxt ",52DBE7E84DC662AAF15DC3AD7C8670F2"
msgid "Jeong woo?"
msgstr "박정우 환자?"

#. Key:	5A531F8842DA9E2DE5A09595EA6B15C8
#. SourceLocation:	/Game/SQ/Last_Run_SQ.Last_Run_SQ_DirectorBP_C:ExecuteUbergraph_Last_Run_SQ_DirectorBP [Script Bytecode]
#: /Game/SQ/Last_Run_SQ.Last_Run_SQ_DirectorBP_C:ExecuteUbergraph_Last_Run_SQ_DirectorBP [Script Bytecode]
msgctxt ",5A531F8842DA9E2DE5A09595EA6B15C8"
msgid "Doctor...?"
msgstr "원장님...?"

#. Key:	69120C814C04CE927F89AC81DBEBF1B5
#. SourceLocation:	/Game/SQ/Last_Run_SQ.Last_Run_SQ_DirectorBP_C:ExecuteUbergraph_Last_Run_SQ_DirectorBP [Script Bytecode]
#: /Game/SQ/Last_Run_SQ.Last_Run_SQ_DirectorBP_C:ExecuteUbergraph_Last_Run_SQ_DirectorBP [Script Bytecode]
msgctxt ",69120C814C04CE927F89AC81DBEBF1B5"
msgid "Oh no.. someone’s coming. What do I do?"
msgstr "이런 ! 누가 온거 같은데 어떡하지?"

#. Key:	8FCCF4B04B6C04BAB29CA48F70F9FA8A
#. SourceLocation:	/Game/SQ/Last_Run_SQ.Last_Run_SQ_DirectorBP_C:ExecuteUbergraph_Last_Run_SQ_DirectorBP [Script Bytecode]
#: /Game/SQ/Last_Run_SQ.Last_Run_SQ_DirectorBP_C:ExecuteUbergraph_Last_Run_SQ_DirectorBP [Script Bytecode]
msgctxt ",8FCCF4B04B6C04BAB29CA48F70F9FA8A"
msgid "Doctor ! What brings you here at this hour?"
msgstr "원장님! 이 시간에 어쩐 일 이세요?"

#. Key:	924718DA468589AB3918A1A367C7BA19
#. SourceLocation:	/Game/SQ/Last_Run_SQ.Last_Run_SQ_DirectorBP_C:ExecuteUbergraph_Last_Run_SQ_DirectorBP [Script Bytecode]
#: /Game/SQ/Last_Run_SQ.Last_Run_SQ_DirectorBP_C:ExecuteUbergraph_Last_Run_SQ_DirectorBP [Script Bytecode]
msgctxt ",924718DA468589AB3918A1A367C7BA19"
msgid "What? Fix what? I'm completely fine!"
msgstr "네 ? 무슨 치료요? 저는 괜찮아요."

#. Key:	98FB43C146BF0F3302FE6AA3C53A3DBE
#. SourceLocation:	/Game/SQ/Last_Run_SQ.Last_Run_SQ_DirectorBP_C:ExecuteUbergraph_Last_Run_SQ_DirectorBP [Script Bytecode]
#: /Game/SQ/Last_Run_SQ.Last_Run_SQ_DirectorBP_C:ExecuteUbergraph_Last_Run_SQ_DirectorBP [Script Bytecode]
msgctxt ",98FB43C146BF0F3302FE6AA3C53A3DBE"
msgid "What the...? Did something fall?"
msgstr "뭐야? 뭐가 떨어진 건가?"

#. Key:	9C5530FA4D9199C4210D19A71EBC2925
#. SourceLocation:	/Game/SQ/Last_Run_SQ.Last_Run_SQ_DirectorBP_C:ExecuteUbergraph_Last_Run_SQ_DirectorBP [Script Bytecode]
#: /Game/SQ/Last_Run_SQ.Last_Run_SQ_DirectorBP_C:ExecuteUbergraph_Last_Run_SQ_DirectorBP [Script Bytecode]
msgctxt ",9C5530FA4D9199C4210D19A71EBC2925"
msgid "Something is terribly wrong. I have the front gate key… I need to get out of this hospital."
msgstr "모든게 이상하다. 마침 정문 열쇠가 있으니, 병원을 빠져 나가야겠다."

#. Key:	BC5BEA3F4DE73FD5FFA110A14BCD5FE9
#. SourceLocation:	/Game/SQ/Last_Run_SQ.Last_Run_SQ_DirectorBP_C:ExecuteUbergraph_Last_Run_SQ_DirectorBP [Script Bytecode]
#: /Game/SQ/Last_Run_SQ.Last_Run_SQ_DirectorBP_C:ExecuteUbergraph_Last_Run_SQ_DirectorBP [Script Bytecode]
msgctxt ",BC5BEA3F4DE73FD5FFA110A14BCD5FE9"
msgid "Something’s wrong... I need to get out of here."
msgstr "이상해.. 나가야겠어."

#. Key:	D477435843493BDA563FA69F2D4D5A28
#. SourceLocation:	/Game/SQ/Last_Run_SQ.Last_Run_SQ_DirectorBP_C:ExecuteUbergraph_Last_Run_SQ_DirectorBP [Script Bytecode]
#: /Game/SQ/Last_Run_SQ.Last_Run_SQ_DirectorBP_C:ExecuteUbergraph_Last_Run_SQ_DirectorBP [Script Bytecode]
msgctxt ",D477435843493BDA563FA69F2D4D5A28"
msgid "Jeong woo? Is that you?"
msgstr "박정우 환자? 맞죠 ??"

#. Key:	DEBCFDBB4CBAC33351E8B1A3EE227608
#. SourceLocation:	/Game/SQ/Last_Run_SQ.Last_Run_SQ_DirectorBP_C:ExecuteUbergraph_Last_Run_SQ_DirectorBP [Script Bytecode]
#: /Game/SQ/Last_Run_SQ.Last_Run_SQ_DirectorBP_C:ExecuteUbergraph_Last_Run_SQ_DirectorBP [Script Bytecode]
msgctxt ",DEBCFDBB4CBAC33351E8B1A3EE227608"
msgid "Jeong woo...? I’m sure he was Patient Park Jeong-woo..."
msgstr "정우님 ? 분명 박정우 환자 였는데.."

#. Key:	B02811A8473BC1B63862D091CF698A6A
#. SourceLocation:	/Game/UI/BuzzWire/WBP_BuzzWire.WBP_BuzzWire_C:WidgetTree.howto.Text
#: /Game/UI/BuzzWire/WBP_BuzzWire.WBP_BuzzWire_C:WidgetTree.howto.Text
msgctxt ",B02811A8473BC1B63862D091CF698A6A"
msgid "Rotate the ring with the mouse wheel."
msgstr "마우스 횔로 링을 회전시킬 수 있습니다."

#. Key:	D12375D1420BA4EBE79C468CA0424912
#. SourceLocation:	/Game/UI/BuzzWire/WBP_BuzzWire.WBP_BuzzWire_C:WidgetTree.Text_Warning.Text
#: /Game/UI/BuzzWire/WBP_BuzzWire.WBP_BuzzWire_C:WidgetTree.Text_Warning.Text
msgctxt ",D12375D1420BA4EBE79C468CA0424912"
msgid "Hover over 'Restart' to try again."
msgstr "'재시작' 버튼에 마우스를 올려 재시작"

#. Key:	8B57225C413A397A808B71A6298D8600
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.Checkok.DialogueText
