msgid "Hi. How's it going?"
msgstr "안녕하세요. 어때요?"

#. Key:	966C8F8142FC2D7CB3C293BCBCA5FF82
#. SourceLocation:	/Game/UI/Data/DT_DialogueData.DT_DialogueData.PM2_01.SpeakerName
#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.PM2_01.SpeakerName
