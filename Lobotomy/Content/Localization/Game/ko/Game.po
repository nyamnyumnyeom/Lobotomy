#: /Game/UI/Data/DT_DialogueData.DT_DialogueData.Nu_1.DialogueText
msgctxt ",4F6BE96C431F4035F9F19190665AB628"
msgid "Where did my name tag go?"
msgstr "제 이름표가 어디 갔죠?"

